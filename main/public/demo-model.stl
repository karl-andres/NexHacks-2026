    outer loop
      vertex 0 0 50
      vertex 25 25 0
      vertex 25 -25 0
    endloop
  endfacet
  facet normal 0 -0.707 0.707
    outer loop
      vertex 0 0 50
      vertex 25 -25 0
      vertex -25 -25 0
    endloop
  endfacet
  facet normal -0.707 0 0.707
    outer loop
      vertex 0 0 50
      vertex -25 -25 0
      vertex -25 25 0
    endloop
  endfacet
  facet normal 0 0.707 -0.707
    outer loop
      vertex 0 0 -50
      vertex 25 25 0
      vertex -25 25 0
    endloop
  endfacet
  facet normal 0.707 0 -0.707
    outer loop
      vertex 0 0 -50
      vertex 25 -25 0
      vertex 25 25 0
    endloop
  endfacet
  facet normal 0 -0.707 -0.707
    outer loop
      vertex 0 0 -50
      vertex -25 -25 0
      vertex 25 -25 0
    endloop
  endfacet
  facet normal -0.707 0 -0.707
    outer loop
      vertex 0 0 -50
      vertex -25 25 0
      vertex -25 -25 0
    endloop
  endfacet
endsolid demo
