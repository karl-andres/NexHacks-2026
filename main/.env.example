# VisionSCAD Environment Variables
# Copy this file to .env and fill in the values

# Overshoot API key for AI vision capabilities (required)
# Get your key from: https://overshoot.ai
OVERSHOOT_API_KEY="your_api_key_here"

# Add additional environment variables below as needed
# For client-side variables, prefix with NEXT_PUBLIC_
# Example: NEXT_PUBLIC_API_URL="https://api.example.com"
